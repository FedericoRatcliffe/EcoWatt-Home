{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=ecowatt;Username=ecowatt;Password=ecowatt"
  },
  "Mqtt": {
    "Enabled": true,
    "Embedded": true,
    "Host": "localhost",
    "Port": 1883,
    "ClientId": "ecowatt-api",
    "Username": null,
    "Password": null,
    "TelemetryTopicFilter": "tele/+/SENSOR",
    "ReconnectDelaySeconds": 5,
    "KeepAliveSeconds": 30
  },
  "Rollup": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "RawRetentionDays": 21
  },
  "Alerts": {
    "Enabled": true,
    "SilenceMinutes": 10,
    "OverrunRatio": 0.15
  },
  "EcoWatt": {
    "TimeZone": "America/Argentina/Buenos_Aires"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}